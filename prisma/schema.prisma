generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id               String            @id @default(cuid())
  username         String            @unique
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  photos           Photo[]
  providerAccounts ProviderAccount[]
  syncFolders      SyncFolder[]
  deletedPhotos    DeletedPhoto[]
  people           Person[]
}

model ProviderAccount {
  id             String    @id @default(cuid())
  userId         String
  provider       String
  providerUserId String?
  email          String?
  accessToken    String
  refreshToken   String?
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}

model Photo {
  id               String          @id @default(cuid())
  userId           String
  originalFilename String
  storageKey       String
  filePath         String
  source           String
  sourceItemId     String?
  fileHash         String?
  takenAt          DateTime?
  latitude         Float?
  longitude        Float?
  country          String?
  city             String?
  placeName        String?
  caption          String?
  lastSeenAt       DateTime?
  missingFromDisk  Boolean         @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  tags             PhotoTag[]
  faces            FaceDetection[]

  @@unique([userId, source, sourceItemId])
  @@unique([userId, storageKey, filePath])
}

model SyncFolder {
  id            String    @id @default(cuid())
  userId        String
  storageKey    String
  folderPath    String
  enabled       Boolean   @default(true)
  lastScannedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, storageKey, folderPath])
}

model Tag {
  id        String     @id @default(cuid())
  name      String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  photos    PhotoTag[]
}

model PhotoTag {
  photoId String
  tagId   String
  photo   Photo  @relation(fields: [photoId], references: [id], onDelete: Cascade)
  tag     Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([photoId, tagId])
}

model DeletedPhoto {
  id         String   @id @default(cuid())
  userId     String
  storageKey String
  filePath   String
  fileHash   String?
  deletedAt  DateTime @default(now())
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, storageKey, filePath])
  @@index([userId, storageKey])
}

model Person {
  id        String          @id @default(cuid())
  userId    String
  name      String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  user  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  faces FaceDetection[]

  @@index([userId, name])
}

model FaceDetection {
  id            String   @id @default(cuid())
  photoId        String
  personId       String?
  clusterKey     String?
  faceIndex      Int
  x              Float
  y              Float
  width          Float
  height         Float
  confidence     Float?
  embeddingJson  String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  photo  Photo   @relation(fields: [photoId], references: [id], onDelete: Cascade)
  person Person? @relation(fields: [personId], references: [id], onDelete: SetNull)

  @@unique([photoId, faceIndex])
  @@index([photoId])
  @@index([personId])
  @@index([clusterKey])
}